# Local development only. Never commit a real .env.
DATABASE_URL=postgres://payvy:payvy@127.0.0.1:5446/payvy
PAYVY_BIND=127.0.0.1:7430
# At least 32 characters. Generate one: openssl rand -hex 32
PAYVY_API_KEY=
# Integration tests (cargo test) create a database per test:
PAYVY_TEST_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5446/postgres
PAYVY_TEST_APP_URL=postgres://payvy:payvy@127.0.0.1:5446
# Document storage: any S3-compatible store (Cloudflare R2, Backblaze B2, AWS
# S3, Garage, SeaweedFS). Without it, document commands say storage isn't set up.
# These values are the local SeaweedFS from docker compose.
PAYVY_S3_ENDPOINT=http://127.0.0.1:8336
PAYVY_S3_BUCKET=payvy-dev
PAYVY_S3_REGION=us-east-1
PAYVY_S3_ACCESS_KEY=payvy-dev
PAYVY_S3_SECRET_KEY=payvy-dev-secret
PAYVY_S3_PATH_STYLE=true
# Create the bucket at startup if missing (local stores only).
# PAYVY_S3_CREATE_BUCKET=true
PAYVY_TEST_S3_ENDPOINT=http://127.0.0.1:8336
PAYVY_TEST_S3_ACCESS_KEY=payvy-dev
PAYVY_TEST_S3_SECRET_KEY=payvy-dev-secret
# Email intake (docs/email-intake.md). Leave unset to turn it off.
# PAYVY_INBOUND_DOMAIN=in.example.com
# PAYVY_INBOUND_SECRET=   # at least 32 characters; the worker signs with it
# Reading bills from documents (docs/extraction.md). Leave unset to turn it off.
# PAYVY_EXTRACT_PROVIDER=anthropic          # or openai-compatible
# PAYVY_EXTRACT_API_KEY=
# PAYVY_EXTRACT_MODEL=claude-opus-5-5       # required for openai-compatible
# PAYVY_EXTRACT_BASE_URL=                   # e.g. http://127.0.0.1:11434/v1 for Ollama
# PAYVY_EXTRACT_AUTO=true                   # read new inbox documents in the background
# Paying through your bank (docs/payments.md). Seals bank API tokens; leave unset to turn it off.
# PAYVY_SECRETS_KEY=   # 64 hex characters: openssl rand -hex 32
# The web app (web/). Sign-in links point at PAYVY_PUBLIC_URL; without a mail
# sender they are written to the server log, which is fine on your machine.
# With `pnpm web` running, open the app on :5173 and set this to match.
PAYVY_PUBLIC_URL=http://127.0.0.1:5173
# PAYVY_WEB_DIR=web/dist                    # serve a built app from the server itself
# PAYVY_MAIL_FROM=Payvy <no-reply@example.com>
# One sender: Cloudflare Email Service...
# PAYVY_CLOUDFLARE_ACCOUNT_ID=
# PAYVY_CLOUDFLARE_EMAIL_TOKEN=             # a Cloudflare API token allowed to send email
# ...or Amazon SES (an IAM key allowed ses:SendEmail; the From domain verified in SES)
# PAYVY_SES_REGION=us-west-2
# PAYVY_SES_ACCESS_KEY_ID=
# PAYVY_SES_SECRET_ACCESS_KEY=

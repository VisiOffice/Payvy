# Secrets for config/deploy.yml, read from 1Password through VisiPass: one approval per deploy,
# and a missing or empty secret stops the deploy. No values live in this file. Keep every line
# in the plain NAME=$(...) form: Kamal doesn't run these through a shell.
# TODO refs are filled in once the items exist (docs/deploy.md).
SECRETS=$(vp kamal-fetch --purpose "Deploy Payvy" KAMAL_REGISTRY_PASSWORD=op://<vault>/<item>/credential POSTGRES_PASSWORD=TODO PAYVY_DB_PASSWORD=TODO PAYVY_API_KEY=TODO PAYVY_INBOUND_SECRET=TODO PAYVY_S3_ACCESS_KEY=TODO PAYVY_S3_SECRET_KEY=TODO PAYVY_EXTRACT_API_KEY=TODO PAYVY_SECRETS_KEY=TODO PAYVY_SES_ACCESS_KEY_ID=TODO PAYVY_SES_SECRET_ACCESS_KEY=TODO)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD ${SECRETS})
PAYVY_DB_PASSWORD=$(kamal secrets extract PAYVY_DB_PASSWORD ${SECRETS})
PAYVY_API_KEY=$(kamal secrets extract PAYVY_API_KEY ${SECRETS})
# Hosted control-plane credential for /operator/* (enable alongside PAYVY_OPERATOR_KEY in config/deploy.yml):
# PAYVY_OPERATOR_KEY=$(kamal secrets extract PAYVY_OPERATOR_KEY ${SECRETS})
PAYVY_INBOUND_SECRET=$(kamal secrets extract PAYVY_INBOUND_SECRET ${SECRETS})
PAYVY_S3_ACCESS_KEY=$(kamal secrets extract PAYVY_S3_ACCESS_KEY ${SECRETS})
PAYVY_S3_SECRET_KEY=$(kamal secrets extract PAYVY_S3_SECRET_KEY ${SECRETS})
PAYVY_EXTRACT_API_KEY=$(kamal secrets extract PAYVY_EXTRACT_API_KEY ${SECRETS})
PAYVY_SECRETS_KEY=$(kamal secrets extract PAYVY_SECRETS_KEY ${SECRETS})
PAYVY_SES_ACCESS_KEY_ID=$(kamal secrets extract PAYVY_SES_ACCESS_KEY_ID ${SECRETS})
PAYVY_SES_SECRET_ACCESS_KEY=$(kamal secrets extract PAYVY_SES_SECRET_ACCESS_KEY ${SECRETS})
# The password is hex, so it needs no URL escaping. payvy-db is the accessory on the kamal network.
DATABASE_URL=postgresql://payvy:${PAYVY_DB_PASSWORD}@payvy-db/payvy
